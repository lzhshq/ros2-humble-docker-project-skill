# ============================================================================
# 项目级配置（被 docker/compose.yaml 通过 env_file 加载）
# 由 ros2-humble-docker-project skill 生成；可按需修改。
# ============================================================================

# 项目名（用于派生容器/镜像名；只允许 [A-Za-z0-9_-]）
PROJECT_NAME={{PROJECT_NAME}}

# ROS2 设置 ----------------------------------------------------------------
# 同一局域网内不同 ROS_DOMAIN_ID 的节点互不发现；调试串扰时可改这里
ROS_DOMAIN_ID=0

# 默认使用 Fast DDS。可改为：rmw_cyclonedds_cpp / rmw_zenoh_cpp 等
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 工作区目录名（项目根下相对路径）
ROS_WS=ros2_ws

# 容器与镜像命名 -----------------------------------------------------------
CONTAINER_NAME={{PROJECT_NAME}}_ros2_humble
IMAGE_NAME={{PROJECT_NAME}}_ros2_humble:latest
